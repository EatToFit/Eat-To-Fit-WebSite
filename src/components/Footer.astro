---
import Logo from './Logo.astro';
import { navigation } from '@/data/navigation';
---
<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div class="brand-col">
        <Logo inverse={true} />
        <p>یک تجربه غذایی ساختاریافته با تمرکز بر شخصی‌سازی، شفافیت و اجرای واقعی در زندگی روزمره.</p>
      </div>
      <div>
        <strong>مسیرها</strong>
        <nav>{navigation.slice(0,6).map(item => <a href={item.href}>{item.label}</a>)}</nav>
      </div>
      <div>
        <strong>اطلاعات</strong>
        <nav>
          <a href="/about">درباره Eat To Fit</a>
          <a href="/faq">سؤالات متداول</a>
          <a href="/contact">ارتباط</a>
          <a href="/privacy">حریم خصوصی</a>
          <a href="/terms">شرایط استفاده</a>
        </nav>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="copyright">© {new Date().getFullYear()} Eat To Fit</div>
      <span>برنامه‌ریزی غذایی؛ نه تشخیص یا درمان پزشکی.</span>
    </div>
  </div>
</footer>
<style>
  .footer{padding:70px 0 24px;color:white;background:linear-gradient(150deg,var(--primary-950),#173b36 70%,#243a37)}.footer-top{display:grid;grid-template-columns:1.4fr .8fr .8fr;gap:60px;padding-bottom:52px}.brand-col p{max-width:480px;color:rgba(255,255,255,.68);margin:20px 0 0}.footer strong{display:block;margin-bottom:14px}.footer nav{display:grid;gap:8px}.footer nav a{width:max-content;color:rgba(255,255,255,.68);font-size:.9rem;padding:2px 0}.footer nav a:hover{color:white}.footer-bottom{display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;padding-top:22px;border-top:1px solid rgba(255,255,255,.1);color:rgba(255,255,255,.48);font-size:.8rem}@media(max-width:760px){.footer-top{grid-template-columns:1fr;gap:34px}.footer{padding-top:54px}}
</style>
