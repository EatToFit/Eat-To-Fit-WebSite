---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { navigation } from '@/data/navigation';
import { siteConfig } from '@/config/site';
const path = Astro.url.pathname;

const desktopItems = navigation.slice(0, 6);
const iconByHref: Record<string, string> = {
  '/': 'home',
  '/how-it-works': 'workflow',
  '/meal-plan': 'fork',
  '/science': 'flask',
  '/questionnaire': 'clipboard',
  '/learn': 'graduation',
  '/about': 'user',
  '/contact': 'message'
};
const isActive = (href: string) => href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---
<header class="site-header" data-header>
  <div class="container nav-shell">
    <Logo />
    <nav class="desktop-nav" aria-label="ناوبری اصلی">
      {desktopItems.map(item => (
        <a class="nav-item" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          <span class="nav-icon" aria-hidden="true"><Icon name={iconByHref[item.href] ?? 'spark'} size={17} stroke={1.9}/></span>
          <span class="nav-label">{item.label}</span>
        </a>
      ))}
    </nav>
    <div class="header-actions">
      <a class="contact-link nav-item" href="/contact" aria-current={isActive('/contact') ? 'page' : undefined}>
        <span class="nav-icon" aria-hidden="true"><Icon name="message" size={17} stroke={1.9}/></span>
        <span class="nav-label">ارتباط</span>
      </a>
      <a class="mini-cta" href={siteConfig.questionnaireUrl} target="_blank" rel="noopener noreferrer">
        <span>شروع ارزیابی</span><Icon name="arrow-up-left" size={17}/>
      </a>
      <button class="menu-button" type="button" aria-label="باز کردن منو" aria-controls="mobile-menu" aria-expanded="false" data-menu-button>
        <span class="menu-icon-open"><Icon name="menu" /></span>
        <span class="menu-icon-close"><Icon name="close" /></span>
      </button>
    </div>
  </div>
  <div class="mobile-panel" id="mobile-menu" data-mobile-menu hidden>
    <div class="container mobile-inner">
      {navigation.map(item => (
        <a class="mobile-nav-item" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          <span class="mobile-nav-icon" aria-hidden="true"><Icon name={iconByHref[item.href] ?? 'spark'} size={19} stroke={1.9}/></span>
          <span>{item.label}</span>
          <span class="mobile-nav-arrow" aria-hidden="true"><Icon name="arrow-left" size={16}/></span>
        </a>
      ))}
      <a class="btn btn-primary mobile-cta" href={siteConfig.questionnaireUrl} target="_blank" rel="noopener noreferrer">شروع ارزیابی <Icon name="arrow-up-left" size={17}/></a>
    </div>
  </div>
</header>
<style>
  .site-header{position:sticky;top:0;z-index:100;padding:12px 0;transition:padding .25s var(--ease),background .25s var(--ease),box-shadow .25s var(--ease)}
  .site-header.scrolled{padding:7px 0;background:rgba(240,242,237,.84);backdrop-filter:blur(20px) saturate(1.15);box-shadow:0 8px 30px rgba(20,45,41,.06)}
  .nav-shell{min-height:60px;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:7px 9px 7px 12px;border:1px solid rgba(215,223,216,.92);border-radius:23px;background:rgba(255,253,250,.88);backdrop-filter:blur(20px) saturate(1.1);box-shadow:0 7px 24px rgba(25,55,49,.07)}
  .desktop-nav{display:flex;align-items:center;gap:3px;min-width:0;margin-inline-end:10px}
  .nav-item{position:relative;display:inline-flex;align-items:center;gap:7px;min-height:42px;padding:6px 9px;border-radius:14px;color:var(--muted);font-size:.84rem;font-weight:750;white-space:nowrap;isolation:isolate;transition:color .22s var(--ease),transform .22s var(--ease),background .22s var(--ease),box-shadow .22s var(--ease)}
  .nav-item::before{content:"";position:absolute;inset:0;border-radius:inherit;background:linear-gradient(145deg,rgba(55,124,113,.11),rgba(255,255,255,.62));opacity:0;transform:scale(.92);transition:opacity .22s var(--ease),transform .22s var(--ease);z-index:-1}
  .nav-item:hover{color:var(--primary-900);transform:translateY(-1px)}
  .nav-item:hover::before{opacity:1;transform:scale(1)}
  .nav-item:active{transform:translateY(0) scale(.975)}
  .nav-icon{width:30px;height:30px;display:grid;place-items:center;border-radius:10px;color:var(--primary-700);background:rgba(55,124,113,.07);border:1px solid rgba(55,124,113,.08);transition:transform .24s var(--ease),background .24s var(--ease),color .24s var(--ease),box-shadow .24s var(--ease)}
  .nav-item:hover .nav-icon{transform:translateY(-1px) rotate(-2deg);background:var(--primary-100);box-shadow:0 6px 14px rgba(36,87,79,.10)}
  .nav-item[aria-current="page"]{color:var(--primary-950);background:linear-gradient(145deg,rgba(231,242,239,.96),rgba(255,255,255,.95));box-shadow:inset 0 0 0 1px rgba(55,124,113,.18),0 7px 18px rgba(36,87,79,.09)}
  .nav-item[aria-current="page"]::after{content:"";position:absolute;right:14px;left:14px;bottom:-7px;height:3px;border-radius:999px;background:linear-gradient(90deg,var(--primary-600),var(--secondary-500));box-shadow:0 2px 8px rgba(55,124,113,.26)}
  .nav-item[aria-current="page"] .nav-icon{color:white;background:linear-gradient(145deg,var(--primary-600),var(--primary-800));border-color:transparent;box-shadow:0 7px 16px rgba(36,87,79,.22)}
  .header-actions{display:flex;align-items:center;gap:6px}
  .contact-link{padding-inline:8px}
  .mini-cta{position:relative;overflow:hidden;display:inline-flex;align-items:center;gap:7px;padding:10px 13px;border-radius:14px;background:linear-gradient(145deg,var(--primary-700),var(--primary-950));color:white;font-size:.82rem;font-weight:850;white-space:nowrap;box-shadow:0 10px 24px rgba(24,61,56,.20);transition:transform .2s var(--ease),box-shadow .2s var(--ease),filter .2s var(--ease)}
  .mini-cta::before{content:"";position:absolute;inset:-60% -30%;background:linear-gradient(110deg,transparent 38%,rgba(255,255,255,.26) 50%,transparent 62%);transform:translateX(52%);transition:transform .55s var(--ease)}
  .mini-cta:hover{transform:translateY(-2px);box-shadow:0 15px 30px rgba(24,61,56,.26);filter:saturate(1.06)}
  .mini-cta:hover::before{transform:translateX(-52%)}
  .mini-cta:active{transform:translateY(0) scale(.97);box-shadow:0 7px 17px rgba(24,61,56,.18)}
  .mini-cta :global(.icon){transition:transform .22s var(--ease)}
  .mini-cta:hover :global(.icon){transform:translate(-2px,-2px)}
  .menu-button{display:none;position:relative;width:43px;height:43px;border-radius:13px;border:1px solid var(--line);background:linear-gradient(145deg,#fff,var(--surface-2));color:var(--ink);box-shadow:0 5px 14px rgba(30,57,52,.05);transition:transform .2s var(--ease),background .2s var(--ease),box-shadow .2s var(--ease),border-color .2s var(--ease)}
  .menu-button:hover{background:var(--primary-50);border-color:var(--primary-200);box-shadow:0 8px 18px rgba(36,87,79,.10)}
  .menu-button:active{transform:scale(.94)}
  .menu-icon-open,.menu-icon-close{position:absolute;inset:0;display:grid;place-items:center;transition:opacity .2s var(--ease),transform .25s var(--ease)}
  .menu-icon-close{opacity:0;transform:rotate(-55deg) scale(.7)}
  .menu-button[aria-expanded="true"] .menu-icon-open{opacity:0;transform:rotate(55deg) scale(.7)}
  .menu-button[aria-expanded="true"] .menu-icon-close{opacity:1;transform:rotate(0) scale(1)}
  .mobile-panel{position:absolute;top:100%;left:0;right:0;padding:0 0 14px;animation:menuIn .25s var(--ease)}
  .mobile-inner{display:grid;gap:6px;padding:12px;background:rgba(255,253,250,.98);border:1px solid var(--line);border-radius:22px;box-shadow:0 24px 60px rgba(30,57,52,.16);backdrop-filter:blur(20px)}
  .mobile-nav-item{position:relative;display:grid;grid-template-columns:38px 1fr 24px;align-items:center;gap:10px;min-height:52px;padding:7px 9px;border-radius:15px;font-weight:750;color:var(--ink-soft);transition:transform .2s var(--ease),background .2s var(--ease),color .2s var(--ease),box-shadow .2s var(--ease)}
  .mobile-nav-icon{width:38px;height:38px;display:grid;place-items:center;border-radius:12px;background:var(--surface-3);color:var(--primary-700);transition:background .2s var(--ease),color .2s var(--ease),transform .2s var(--ease)}
  .mobile-nav-arrow{display:grid;place-items:center;color:var(--muted-2);opacity:.7;transition:transform .2s var(--ease),opacity .2s var(--ease)}
  .mobile-nav-item:hover{background:var(--primary-50);color:var(--primary-900);transform:translateX(-2px)}
  .mobile-nav-item:hover .mobile-nav-icon{background:var(--primary-100);transform:scale(1.04)}
  .mobile-nav-item:hover .mobile-nav-arrow{transform:translateX(-3px);opacity:1}
  .mobile-nav-item:active{transform:scale(.985)}
  .mobile-nav-item[aria-current="page"]{background:linear-gradient(135deg,var(--primary-100),rgba(244,230,232,.58));color:var(--primary-950);box-shadow:inset 0 0 0 1px rgba(55,124,113,.13)}
  .mobile-nav-item[aria-current="page"] .mobile-nav-icon{color:white;background:linear-gradient(145deg,var(--primary-600),var(--primary-800));box-shadow:0 7px 16px rgba(36,87,79,.18)}
  .mobile-cta{margin-top:4px}
  @keyframes menuIn{from{opacity:0;transform:translateY(-8px) scale(.985)}to{opacity:1;transform:none}}
  @media(max-width:1180px){.nav-item{gap:5px;padding-inline:7px;font-size:.79rem}.nav-icon{width:28px;height:28px}.mini-cta{padding-inline:11px}}
  @media(max-width:1080px){.desktop-nav{display:none;margin-inline-end:0}.menu-button{display:block}.contact-link{display:none}}
  @media(max-width:520px){.mini-cta{display:none}.nav-shell{padding:7px 8px}}
  @media(prefers-reduced-motion:reduce){.mobile-panel{animation:none}.nav-item,.nav-icon,.mini-cta,.menu-button,.menu-icon-open,.menu-icon-close,.mobile-nav-item,.mobile-nav-icon,.mobile-nav-arrow{transition:none}.mini-cta::before{display:none}}
</style>
