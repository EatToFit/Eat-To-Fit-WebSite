---
interface Props { name: string; size?: number; stroke?: number; }
const { name, size = 22, stroke = 1.8 } = Astro.props;
---
<svg class="icon" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">

  {name === 'home' && <><path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v10h13V10"/><path d="M9.5 20v-6h5v6"/></>}
  {name === 'workflow' && <><rect x="3" y="4" width="6" height="5" rx="1.5"/><rect x="15" y="15" width="6" height="5" rx="1.5"/><path d="M9 6.5h4a3 3 0 0 1 3 3v5.5"/><path d="m13 12 3 3 3-3"/></>}
  {name === 'flask' && <><path d="M9 3h6"/><path d="M10 3v6l-5 8.5A2.3 2.3 0 0 0 7 21h10a2.3 2.3 0 0 0 2-3.5L14 9V3"/><path d="M7.5 16h9"/></>}
  {name === 'clipboard' && <><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4.5V3h6v1.5"/><path d="m9 12 2 2 4-4"/><path d="M9 17h6"/></>}
  {name === 'graduation' && <><path d="m3 9 9-5 9 5-9 5-9-5Z"/><path d="M7 11.5V16c2.8 2 7.2 2 10 0v-4.5"/><path d="M21 9v6"/></>}

  {name === 'arrow-left' && <><path d="M19 12H5"/><path d="m11 18-6-6 6-6"/></>}
  {name === 'arrow-up-left' && <><path d="M17 17 7 7"/><path d="M17 7H7v10"/></>}
  {name === 'user' && <><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></>}
  {name === 'target' && <><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/><path d="M17.5 6.5 21 3"/><path d="M17 3h4v4"/></>}
  {name === 'activity' && <><path d="M3 12h4l2-6 4 12 2-6h6"/></>}
  {name === 'fork' && <><path d="M6 3v8"/><path d="M3 3v5a3 3 0 0 0 6 0V3"/><path d="M6 11v10"/><path d="M16 3v18"/><path d="M16 3c3 2 4 5 4 8h-4"/></>}
  {name === 'adjust' && <><path d="M4 6h10"/><path d="M18 6h2"/><circle cx="16" cy="6" r="2"/><path d="M4 12h2"/><path d="M10 12h10"/><circle cx="8" cy="12" r="2"/><path d="M4 18h8"/><path d="M16 18h4"/><circle cx="14" cy="18" r="2"/></>}
  {name === 'check' && <path d="m5 12 4 4L19 6"/>}
  {name === 'shield' && <><path d="M12 3 5 6v5c0 5 3 8 7 10 4-2 7-5 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></>}
  {name === 'book' && <><path d="M4 5a3 3 0 0 1 3-2h5v16H7a3 3 0 0 0-3 2V5Z"/><path d="M20 5a3 3 0 0 0-3-2h-5v16h5a3 3 0 0 1 3 2V5Z"/></>}
  {name === 'spark' && <><path d="m12 3 1.4 4.1L17.5 8.5l-4.1 1.4L12 14l-1.4-4.1-4.1-1.4 4.1-1.4L12 3Z"/><path d="m18 14 .8 2.2L21 17l-2.2.8L18 20l-.8-2.2L15 17l2.2-.8L18 14Z"/></>}
  {name === 'droplet' && <path d="M12 3s6 6 6 11a6 6 0 1 1-12 0c0-5 6-11 6-11Z"/>}
  {name === 'moon' && <path d="M20 16.5A8.5 8.5 0 0 1 8 4a8.5 8.5 0 1 0 12 12.5Z"/>}
  {name === 'heart' && <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/>}
  {name === 'menu' && <><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/></>}
  {name === 'close' && <><path d="M6 6l12 12"/><path d="M18 6 6 18"/></>}
  {name === 'plus' && <><path d="M12 5v14"/><path d="M5 12h14"/></>}

  {name === 'clock' && <><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></>}
  {name === 'dumbbell' && <><path d="M6 8v8"/><path d="M3 10v4"/><path d="M18 8v8"/><path d="M21 10v4"/><path d="M6 12h12"/></>}
  {name === 'send' && <><path d="m22 2-7 20-4-9-9-4 20-7Z"/><path d="M22 2 11 13"/></>}
  {name === 'message' && <><path d="M21 15a4 4 0 0 1-4 4H8l-5 3 1.5-5A7 7 0 0 1 3 13V8a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v7Z"/></>}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></>}
  {name === 'external' && <><path d="M14 4h6v6"/><path d="M20 4 10 14"/><path d="M18 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h6"/></>}
  {name === 'layers' && <><path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 12 9 5 9-5"/><path d="m3 16 9 5 9-5"/></>}
  {name === 'database' && <><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5"/><path d="M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/></>}
</svg>
