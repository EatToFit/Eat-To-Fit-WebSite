---
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import { SignOutButton } from '@clerk/astro/components';
import { ensureApplicationUser } from '@/lib/server/app-user';
import {
  getClientProfile,
  isClientProfileComplete,
} from '@/lib/server/client-profile';

Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

const { isAuthenticated } = Astro.locals.auth();

if (!isAuthenticated) {
  return Astro.redirect('/sign-in');
}

const clerkUser = await Astro.locals.currentUser();

if (!clerkUser) {
  return Astro.redirect('/sign-in');
}

const appUser = await ensureApplicationUser(clerkUser);
const profile = await getClientProfile(appUser.id);

if (!isClientProfileComplete(profile)) {
  return Astro.redirect('/app/onboarding');
}

const isPending = appUser.account_status === 'PENDING';
const isActive = appUser.account_status === 'ACTIVE';
const isSuspended = appUser.account_status === 'SUSPENDED';
---

<BaseLayout
  title="حساب کاربری | Eat To Fit"
  description="وضعیت حساب Eat To Fit"
  noindex={true}
>
  <main class="account-page">
    <div class="container account-container">
      <section class="account-state-card" aria-labelledby="account-status-title">
        {isPending && (
          <div class="account-state">
            <span class="eyebrow">اطلاعات شما ثبت شد</span>
            <h1 id="account-status-title">حساب شما در حال بررسی است</h1>
            <p>
              پروفایل شما تکمیل شده است. پس از تطبیق اطلاعات و بررسی نهایی،
              دسترسی شخصی شما فعال خواهد شد.
            </p>
          </div>
        )}

        {isActive && (
          <div class="account-state">
            <span class="eyebrow">حساب فعال</span>
            <h1 id="account-status-title">حساب شما فعال است</h1>
            <p>فضای شخصی شما آماده استفاده است.</p>
          </div>
        )}

        {isSuspended && (
          <div class="account-state">
            <span class="eyebrow">وضعیت حساب</span>
            <h1 id="account-status-title">
              دسترسی این حساب موقتاً غیرفعال شده است
            </h1>
            <p>
              برای بررسی وضعیت حساب، با پشتیبانی Eat To Fit در ارتباط باشید.
            </p>
          </div>
        )}

        <div class="account-actions">
          <SignOutButton redirectUrl="/">
            <button class="btn btn-secondary" type="button">خروج از حساب</button>
          </SignOutButton>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .account-page {
    min-height: 70vh;
    display: grid;
    place-items: center;
    padding: clamp(2rem, 6vw, 5rem) 0;
  }

  .account-container {
    width: 100%;
  }

  .account-state-card {
    width: min(100%, 760px);
    margin-inline: auto;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid rgba(55, 124, 113, 0.16);
    border-radius: 28px;
    background: linear-gradient(145deg, rgba(255,255,255,.97), rgba(247,251,249,.94));
    box-shadow: 0 24px 70px rgba(24,61,56,.10), inset 0 1px 0 rgba(255,255,255,.9);
  }

  .account-state h1 {
    margin: .9rem 0 .75rem;
    color: #183d38;
    font-size: clamp(1.8rem, 4vw, 2.7rem);
    line-height: 1.45;
  }

  .account-state p {
    margin: 0;
    color: #66736f;
    line-height: 2;
  }

  .account-actions {
    margin-top: 1.75rem;
  }
</style>
