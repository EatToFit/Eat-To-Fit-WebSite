---
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import { ensureApplicationUser } from '@/lib/server/app-user';
import {
  completeClientProfile,
  getClientProfile,
  isClientProfileComplete,
  normalizePhoneE164,
  validatePersonName,
} from '@/lib/server/client-profile';

Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

const { isAuthenticated } = Astro.locals.auth();

if (!isAuthenticated) {
  return Astro.redirect('/sign-in');
}

const clerkUser = await Astro.locals.currentUser();

if (!clerkUser) {
  return Astro.redirect('/sign-in');
}

const appUser = await ensureApplicationUser(clerkUser);
let profile = await getClientProfile(appUser.id);

if (isClientProfileComplete(profile) && Astro.request.method !== 'POST') {
  return Astro.redirect('/account-ready');
}

type FormErrors = {
  firstName?: string;
  lastName?: string;
  countryCode?: string;
  phone?: string;
  form?: string;
};

let errors: FormErrors = {};
let firstName = profile?.first_name ?? clerkUser.firstName ?? '';
let lastName = profile?.last_name ?? clerkUser.lastName ?? '';
let countryCode = '+98';
let phone = '';

if (profile?.phone_e164?.startsWith('+98')) {
  phone = `0${profile.phone_e164.slice(3)}`;
}

if (Astro.request.method === 'POST') {
  const origin = Astro.request.headers.get('origin');

  if (origin && origin !== Astro.url.origin) {
    errors.form = 'درخواست نامعتبر بود. لطفاً صفحه را دوباره بارگذاری کنید.';
  } else {
    const data = await Astro.request.formData();

    firstName = String(data.get('first_name') ?? '');
    lastName = String(data.get('last_name') ?? '');
    countryCode = String(data.get('country_code') ?? '+98');
    phone = String(data.get('phone') ?? '');

    const validFirstName = validatePersonName(firstName);
    const validLastName = validatePersonName(lastName);
    const phoneE164 = normalizePhoneE164(countryCode, phone);

    if (!validFirstName) {
      errors.firstName = 'نام را به‌صورت صحیح وارد کنید.';
    }

    if (!validLastName) {
      errors.lastName = 'نام خانوادگی را به‌صورت صحیح وارد کنید.';
    }

    if (!/^\+?[0-9۰-۹٠-٩]{1,4}$/.test(countryCode.trim())) {
      errors.countryCode = 'پیش‌شماره معتبر نیست.';
    }

    if (!phoneE164) {
      errors.phone = 'شماره همراه معتبر وارد کنید.';
    }

    if (
      !errors.firstName &&
      !errors.lastName &&
      !errors.countryCode &&
      !errors.phone &&
      !errors.form &&
      validFirstName &&
      validLastName &&
      phoneE164
    ) {
      await completeClientProfile({
        userId: appUser.id,
        firstName: validFirstName,
        lastName: validLastName,
        phoneE164,
      });

      return Astro.redirect('/account-ready?profile=complete', 303);
    }
  }
}
---

<BaseLayout
  title="تکمیل پروفایل | Eat To Fit"
  description="تکمیل اطلاعات حساب شخصی Eat To Fit"
  noindex={true}
>
  <main class="onboarding-page">
    <div class="onboarding-glow onboarding-glow--green" aria-hidden="true"></div>
    <div class="onboarding-glow onboarding-glow--wine" aria-hidden="true"></div>

    <div class="container onboarding-wrap">
      <section class="onboarding-card" aria-labelledby="profile-title">
        <div class="onboarding-copy">
          <span class="step-chip">مرحله نهایی ساخت حساب</span>

          <h1 id="profile-title">اطلاعات پروفایل خود را تکمیل کنید</h1>

          <p>
            این اطلاعات برای شناسایی حساب شما و تطبیق آن با پرسشنامه استفاده
            می‌شود. پاسخ‌های پرسشنامه در این بخش ذخیره نمی‌شوند.
          </p>

          <div class="privacy-note">
            <span class="privacy-icon" aria-hidden="true">✓</span>
            <span>
              ایمیل و رمز عبور برای ورود استفاده می‌شوند؛ شماره همراه فقط بخشی
              از پروفایل و فرآیند تطبیق شماست.
            </span>
          </div>
        </div>

        <form method="POST" class="profile-form" novalidate>
          {errors.form && (
            <div class="form-alert" role="alert">
              {errors.form}
            </div>
          )}

          <div class="name-grid">
            <label class="field">
              <span>نام</span>
              <input
                type="text"
                name="first_name"
                autocomplete="given-name"
                value={firstName}
                maxlength="80"
                required
                aria-invalid={Boolean(errors.firstName)}
              />
              {errors.firstName && <small role="alert">{errors.firstName}</small>}
            </label>

            <label class="field">
              <span>نام خانوادگی</span>
              <input
                type="text"
                name="last_name"
                autocomplete="family-name"
                value={lastName}
                maxlength="80"
                required
                aria-invalid={Boolean(errors.lastName)}
              />
              {errors.lastName && <small role="alert">{errors.lastName}</small>}
            </label>
          </div>

          <div class="phone-fieldset">
            <span class="field-title">شماره همراه</span>

            <div class="phone-grid">
              <label class="field country-code">
                <span class="sr-only">پیش‌شماره کشور</span>
                <input
                  type="text"
                  inputmode="tel"
                  name="country_code"
                  value={countryCode}
                  maxlength="4"
                  aria-label="پیش‌شماره کشور"
                  required
                />
              </label>

              <label class="field phone-number">
                <span class="sr-only">شماره همراه</span>
                <input
                  type="tel"
                  inputmode="tel"
                  name="phone"
                  autocomplete="tel-national"
                  value={phone}
                  placeholder="مثلاً ۰۹۱۲۱۲۳۴۵۶۷"
                  maxlength="20"
                  aria-invalid={Boolean(errors.phone)}
                  required
                />
              </label>
            </div>

            {(errors.countryCode || errors.phone) && (
              <small class="phone-error" role="alert">
                {errors.countryCode ?? errors.phone}
              </small>
            )}

            <small class="field-help">
              پیش‌شماره ایران به‌صورت پیش‌فرض +۹۸ است و در صورت نیاز قابل تغییر
              است.
            </small>
          </div>

          <button class="submit-button" type="submit">
            ذخیره و ادامه
            <span aria-hidden="true">←</span>
          </button>

          <p class="form-footnote">
            پس از تکمیل این مرحله، حساب شما تا زمان بررسی نهایی در وضعیت انتظار
            باقی می‌ماند.
          </p>
        </form>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .onboarding-page {
    position: relative;
    min-height: 75vh;
    display: grid;
    place-items: center;
    overflow: hidden;
    padding: clamp(2rem, 5vw, 4.5rem) 0;
    background:
      radial-gradient(circle at 88% 10%, rgba(55,124,113,.13), transparent 28rem),
      radial-gradient(circle at 4% 92%, rgba(124,55,66,.10), transparent 24rem),
      linear-gradient(145deg, #f4f8f6 0%, #fffaf7 52%, #edf5f2 100%);
  }

  .onboarding-wrap {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .onboarding-card {
    width: min(100%, 1050px);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, .85fr) minmax(360px, .75fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    padding: clamp(1.4rem, 4vw, 3rem);
    border: 1px solid rgba(55,124,113,.15);
    border-radius: 32px;
    background: rgba(255,255,255,.88);
    box-shadow: 0 30px 90px rgba(24,61,56,.13);
    backdrop-filter: blur(18px);
  }

  .onboarding-copy {
    align-self: center;
  }

  .step-chip {
    display: inline-flex;
    align-items: center;
    padding: .5rem .8rem;
    border-radius: 999px;
    background: #eaf4f0;
    color: #2d6c63;
    font-size: .82rem;
    font-weight: 900;
  }

  .onboarding-copy h1 {
    margin: 1.1rem 0 .8rem;
    color: #183d38;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.35;
  }

  .onboarding-copy > p {
    margin: 0;
    color: #66736f;
    line-height: 2;
  }

  .privacy-note {
    margin-top: 1.4rem;
    display: flex;
    gap: .75rem;
    align-items: flex-start;
    padding: 1rem;
    border: 1px solid #dbe8e3;
    border-radius: 18px;
    background: #f5faf8;
    color: #53645f;
    line-height: 1.85;
    font-size: .9rem;
  }

  .privacy-icon {
    flex: 0 0 auto;
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    border-radius: 9px;
    background: #dceee8;
    color: #26665d;
    font-weight: 900;
  }

  .profile-form {
    align-self: center;
    padding: clamp(1.15rem, 3vw, 1.75rem);
    border: 1px solid #e0e8e4;
    border-radius: 24px;
    background: linear-gradient(180deg, #fff, #fbfdfc);
    box-shadow: 0 16px 42px rgba(24,61,56,.08);
  }

  .name-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .9rem;
  }

  .field {
    display: grid;
    gap: .45rem;
  }

  .field > span,
  .field-title {
    color: #183d38;
    font-size: .88rem;
    font-weight: 900;
  }

  .field input {
    width: 100%;
    min-height: 54px;
    padding: 0 1rem;
    border: 1.5px solid #cfdbd6;
    border-radius: 16px;
    background: #fff;
    color: #183d38;
    font: inherit;
    outline: 0;
    transition: border-color .16s ease, box-shadow .16s ease;
  }

  .field input:hover {
    border-color: #9eb5ad;
  }

  .field input:focus {
    border-color: #377c71;
    box-shadow: 0 0 0 4px rgba(55,124,113,.12);
  }

  .field input[aria-invalid="true"] {
    border-color: #b44756;
  }

  .field small,
  .phone-error {
    color: #a53c4d;
    font-size: .78rem;
    font-weight: 700;
  }

  .phone-fieldset {
    margin-top: 1rem;
  }

  .phone-grid {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: .7rem;
    margin-top: .45rem;
    direction: ltr;
  }

  .country-code input,
  .phone-number input {
    direction: ltr;
    text-align: left;
  }

  .field-help {
    display: block;
    margin-top: .55rem;
    color: #7a8782;
    font-size: .77rem;
    line-height: 1.7;
  }

  .submit-button {
    width: 100%;
    min-height: 56px;
    margin-top: 1.2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .65rem;
    border: 1px solid #245c54;
    border-radius: 16px;
    background: linear-gradient(135deg, #183d38, #2d6c63 52%, #438f83);
    color: #fff;
    font: inherit;
    font-weight: 900;
    cursor: pointer;
    box-shadow: 0 13px 28px rgba(24,61,56,.21);
    transition: transform .16s ease, box-shadow .16s ease;
  }

  .submit-button:hover {
    transform: translateY(-1px);
    box-shadow: 0 16px 34px rgba(24,61,56,.27);
  }

  .submit-button:focus-visible {
    outline: 4px solid rgba(55,124,113,.2);
    outline-offset: 3px;
  }

  .form-footnote {
    margin: .9rem 0 0;
    color: #77837f;
    text-align: center;
    font-size: .78rem;
    line-height: 1.7;
  }

  .form-alert {
    margin-bottom: 1rem;
    padding: .85rem 1rem;
    border: 1px solid #efd1d7;
    border-radius: 14px;
    background: #fff7f8;
    color: #9e3544;
    font-size: .86rem;
    font-weight: 700;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  .onboarding-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
    pointer-events: none;
  }

  .onboarding-glow--green {
    width: 360px;
    height: 360px;
    right: -150px;
    top: -120px;
    background: radial-gradient(circle, rgba(55,124,113,.12), transparent 68%);
  }

  .onboarding-glow--wine {
    width: 330px;
    height: 330px;
    left: -150px;
    bottom: -130px;
    background: radial-gradient(circle, rgba(124,55,66,.09), transparent 68%);
  }

  @media (max-width: 820px) {
    .onboarding-card {
      grid-template-columns: 1fr;
      max-width: 620px;
    }
  }

  @media (max-width: 520px) {
    .onboarding-page {
      padding: 1rem 0;
    }

    .onboarding-card {
      gap: 1.25rem;
      padding: 1rem;
      border-radius: 24px;
    }

    .onboarding-copy h1 {
      font-size: 1.75rem;
    }

    .name-grid {
      grid-template-columns: 1fr;
    }

    .phone-grid {
      grid-template-columns: 92px 1fr;
    }

    .field input,
    .submit-button {
      min-height: 52px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .field input,
    .submit-button {
      transition: none;
    }
  }
</style>
