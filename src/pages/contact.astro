---
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { siteConfig } from '@/config/site';
const channels = [
  siteConfig.social.telegram && ['تلگرام', siteConfig.social.telegram, 'send'],
  siteConfig.social.instagram && ['اینستاگرام', siteConfig.social.instagram, 'heart'],
  siteConfig.social.whatsapp && ['واتساپ', siteConfig.social.whatsapp, 'message'],
  siteConfig.social.email && ['ایمیل', `mailto:${siteConfig.social.email}`, 'mail']
].filter(Boolean);
---
<BaseLayout title="ارتباط | Eat To Fit" description="راه‌های رسمی ارتباط با Eat To Fit و مسیر شروع ارزیابی غذایی.">
  <section class="page-hero page-hero-tinted"><div class="container page-hero-inner"><div class="breadcrumb"><a href="/">خانه</a><span>/</span><span>ارتباط</span></div><span class="eyebrow">راه‌های ارتباطی</span><h1 class="h1">برای شروع یا پرسیدن سؤال، <span class="accent">مستقیم در ارتباط باشید.</span></h1><p class="lead">برای پرسش قبل از شروع، پیگیری یا دریافت راهنمایی درباره مراحل، از کانال‌های رسمی Eat To Fit استفاده کنید.</p></div></section>
  <section class="section"><div class="container contact-grid"><div class="contact-card"><div class="icon-box"><Icon name="mail"/></div><h2>کانال‌های رسمی</h2><p class="intro">در حال حاضر تلگرام مسیر اصلی ارتباط است.</p><div class="channels">{channels.map((item:any) => <a href={item[1]} target="_blank" rel="noopener noreferrer"><span><Icon name={item[2]} size={19}/>{item[0]}</span><Icon name="arrow-up-left" size={17}/></a>)}</div></div><div class="start-card"><span class="eyebrow">برای شروع برنامه</span><h2>آماده‌اید اطلاعات اولیه را ثبت کنید؟</h2><p>پرسشنامه به ما کمک می‌کند هدف، سبک زندگی، تمرین، زمان وعده‌ها و ترجیحات غذایی شما را بهتر بشناسیم.</p><div class="mini-points"><span><Icon name="check" size={16}/> شناخت هدف و شرایط</span><span><Icon name="check" size={16}/> ثبت ترجیحات غذایی</span><span><Icon name="check" size={16}/> هماهنگی بیشتر برنامه با شما</span></div><a class="btn btn-light" href={siteConfig.questionnaireUrl} target="_blank" rel="noopener noreferrer">باز کردن پرسشنامه <Icon name="arrow-up-left" size={17}/></a></div></div></section>
</BaseLayout>
<style>
.contact-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:22px}.contact-card,.start-card{border-radius:34px;padding:34px;box-shadow:var(--shadow-sm)}.contact-card{background:linear-gradient(145deg,#fff,var(--primary-50));border:1px solid var(--primary-200)}.contact-card .icon-box{margin-bottom:18px}.contact-card h2,.start-card h2{font-size:1.6rem;margin:0 0 8px}.intro{color:var(--muted);margin-top:0}.channels{display:grid;gap:10px;margin-top:22px}.channels a{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:15px 17px;border-radius:18px;background:white;border:1px solid var(--line);font-weight:800;transition:.2s}.channels a:hover{transform:translateY(-2px);border-color:var(--primary-300);box-shadow:var(--shadow-xs)}.channels a>span{display:flex;align-items:center;gap:10px;color:var(--primary-800)}.start-card{color:white;background:radial-gradient(circle at 10% 15%,rgba(255,255,255,.12),transparent 13rem),radial-gradient(circle at 90% 95%,rgba(153,81,93,.25),transparent 18rem),linear-gradient(145deg,var(--primary-950),var(--primary-700));border:1px solid rgba(255,255,255,.08)}.start-card .eyebrow{color:white;background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.14)}.start-card p{color:rgba(255,255,255,.74)}.mini-points{display:flex;flex-wrap:wrap;gap:8px;margin:22px 0}.mini-points span{display:flex;align-items:center;gap:6px;padding:8px 10px;border-radius:12px;background:rgba(255,255,255,.08);font-size:.78rem}.start-card .btn{margin-top:4px}@media(max-width:780px){.contact-grid{grid-template-columns:1fr}.contact-card,.start-card{padding:26px}}
</style>
