---
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import PlanPreview from '@/components/PlanPreview.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { siteConfig } from '@/config/site';
---
<BaseLayout title="برنامه غذایی | Eat To Fit" description="با تجربه برنامه غذایی Eat To Fit، ساختار وعده‌ها و شیوه نمایش مقدارهای قابل فهم آشنا شوید.">
  <section class="page-hero page-hero-tinted"><div class="container page-hero-inner"><div class="breadcrumb"><a href="/">خانه</a><span>/</span><span>برنامه غذایی</span></div><span class="eyebrow">تجربه برنامه</span><h1 class="h1">برنامه‌ای که قرار است <span class="accent-warm">در زندگی روزمره</span> همراه شما باشد.</h1><p class="lead">هر وعده با زبان روشن، مقدارهای قابل فهم و انتخاب‌هایی متناسب با سبک غذایی شما نمایش داده می‌شود تا اجرای برنامه ساده‌تر و طبیعی‌تر باشد.</p></div></section>
  <section class="section"><div class="container experience-grid"><div><SectionHeading eyebrow="یک نگاه ساده" title="همه چیز باید در یک نگاه قابل فهم باشد" text="برای هر وعده، مهم‌ترین اطلاعات بدون شلوغی و اصطلاحات اضافه در دسترس شما قرار می‌گیرد."/><div class="feature-list"><div><span class="icon-box"><Icon name="adjust"/></span><p><strong>مقدارهای قابل فهم</strong><small>واحدها طوری نوشته می‌شوند که در آشپزخانه و سر میز قابل استفاده باشند.</small></p></div><div><span class="icon-box warm"><Icon name="fork"/></span><p><strong>تنوع غذایی</strong><small>غذاهای ایرانی و بین‌المللی می‌توانند متناسب با ترجیحات شما کنار هم قرار بگیرند.</small></p></div><div><span class="icon-box"><Icon name="heart"/></span><p><strong>انتخاب‌های نزدیک به سلیقه شما</strong><small>علاقه‌ها، محدودیت‌ها و غذاهای نامطلوب در انتخاب گزینه‌ها در نظر گرفته می‌شوند.</small></p></div></div></div><div><PlanPreview /></div></div></section>
  <section class="section section-color-b"><div class="container"><SectionHeading eyebrow="برای اجرا" title="رژیم زمانی ارزشمند است که بتوانید با آن زندگی کنید" text="هدف فقط چیدن غذاها کنار هم نیست؛ ساختن برنامه‌ای است که با زمان‌بندی، عادت‌ها و انتخاب‌های واقعی شما جور دربیاید."/><div class="grid-3"><article class="card color-card"><Icon name="clock"/><h3>هماهنگ با زمان شما</h3><p>وعده‌ها می‌توانند با ساعت کار، تمرین و الگوی روزانه شما هماهنگ شوند.</p></article><article class="card color-card warm-card"><Icon name="fork"/><h3>غذاهای آشنا و متنوع</h3><p>برنامه قرار نیست شما را از غذاهای معمول و موردعلاقه‌تان جدا کند؛ انتخاب‌ها با توجه به شرایط تنظیم می‌شوند.</p></article><article class="card color-card"><Icon name="spark"/><h3>ظاهر روشن و کاربردی</h3><p>ساختار برنامه طوری طراحی شده که پیدا کردن وعده، مقدار و انتخاب بعدی سریع و ساده باشد.</p></article></div></div></section>
  <section class="section-tight"><div class="container boundary"><div><span class="eyebrow">قدم بعدی</span><h2 class="h2">برای شروع، شرایط و ترجیحاتتان را ثبت کنید.</h2><p class="lead">پرسشنامه کمک می‌کند تصویر دقیق‌تری از سبک زندگی، هدف و انتخاب‌های غذایی شما داشته باشیم.</p></div><a class="btn btn-primary" href={siteConfig.questionnaireUrl} target="_blank" rel="noopener noreferrer">شروع ارزیابی <Icon name="arrow-up-left" size={18}/></a></div></section>
</BaseLayout>
<style>
.experience-grid{display:grid;grid-template-columns:1fr 1fr;gap:62px;align-items:center}.feature-list{display:grid;gap:12px;margin-top:28px}.feature-list>div{display:flex;align-items:center;gap:14px;padding:15px 16px;border-radius:20px;background:rgba(255,255,255,.78);border:1px solid var(--line)}.feature-list p{display:grid;margin:0}.feature-list small{color:var(--muted);margin-top:3px}.color-card{position:relative;overflow:hidden}.color-card>svg{color:var(--primary-700);margin-bottom:16px}.color-card::after{content:"";position:absolute;width:130px;height:130px;border-radius:50%;left:-55px;bottom:-65px;background:rgba(55,124,113,.08)}.warm-card>svg{color:var(--secondary-600)}.warm-card::after{background:rgba(124,55,66,.09)}.boundary{display:flex;align-items:center;justify-content:space-between;gap:28px;padding:36px;border-radius:32px;background:linear-gradient(135deg,var(--primary-950),var(--primary-700));color:white;box-shadow:var(--shadow-md)}.boundary .lead{color:rgba(255,255,255,.72)}.boundary .eyebrow{color:white;background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.14)}@media(max-width:850px){.experience-grid{grid-template-columns:1fr;gap:38px}.boundary{align-items:flex-start;flex-direction:column}}
</style>
